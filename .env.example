APP_NAME=Password Manager
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/password_manager

# Used for sessions and rate-limit counters.
# Production: use TLS and auth, e.g. rediss://:<password>@<host>:6379/0
REDIS_URL=redis://localhost:6379/0

# Required. URL-safe base64 of 32 random bytes. Generate with:
# python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_ENCRYPTION_KEY=

# Rate limiting. Limits are request counts per window; all values must be > 0.
RATE_LIMIT_ENABLED=true

# POST /auth/login, per client IP
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# POST /auth/register, per client IP
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# All /api/v1/vault endpoints, per authenticated user
RATE_LIMIT_USER_LIMIT=60
RATE_LIMIT_USER_WINDOW_SECONDS=60
